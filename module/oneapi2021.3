#%Module1.0
##
## CCAM (Conformal Cubic Atmospheric Model) - OneAPI 2021.3 build
##

proc ModulesHelp { } {
    puts stderr "CCAM on Lengau (Intel OneAPI 2021.3, NetCDF 4.9.2)"
    puts stderr ""
    puts stderr "  CCAM_ROOT  - executables: globpea, g2n, terread, ..."
    puts stderr "  CCAM_DATA  - shared static data (vegin, ccamdata)"
    puts stderr "  VEGIN      - vegetation input directory"
    puts stderr ""
    puts stderr "Run globpea with mpirun inside a PBS job."
    puts stderr "User guide: https://github.com/msovara/ccam-lengau"
}

module-whatis "CCAM (Conformal Cubic Atmospheric Model) - OneAPI 2021.3"

set ccam_root "/home/apps/chpc/earth/CCAM-oneapi2021.3"
set ccam_data "/home/apps/chpc/earth/CCAM/ccaminstall"
set oneapi_base "/home/apps/chpc/compmech/compilers/intel_2021.3/oneapi"

if { [module-info mode load] } {
    module load chpc/earth/netcdf/4.9.2-intel2021.3
}

setenv CCAM_ROOT $ccam_root
setenv CCAM_DATA $ccam_data
setenv VEGIN $ccam_data/vegin

prepend-path PATH $ccam_root/bin

prepend-path LD_LIBRARY_PATH $oneapi_base/compiler/2021.3.0/linux/compiler/lib/intel64
prepend-path LD_LIBRARY_PATH $oneapi_base/mpi/2021.3.0/lib
prepend-path LD_LIBRARY_PATH $oneapi_base/mpi/2021.3.0/libfabric/lib

puts stderr "CCAM (OneAPI 2021.3) loaded"
puts stderr "  Binaries:  $ccam_root/bin"
puts stderr "  Data:      $ccam_data (VEGIN, ccamdata)"
